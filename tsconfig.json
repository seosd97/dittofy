{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": "src",
		"paths": {
			"@aspects/*": ["./src/aspects/*"],
			"@llm/*": ["./src/llm/*"],
			"@source/*": ["./src/source/*"],
			"@output/*": ["./src/output/*"],
			"@pipeline/*": ["./src/pipeline/*"],
			"@cli/*": ["./src/cli/*"],
			"@config/*": ["./src/config/*"],
			"@defs/*": ["./src/types/*"],
			"@utils/*": ["./src/utils/*"]
		}
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
