{
	"name": "dittofy",
	"version": "0.0.0",
	"description": "Analyze FE repositories to extract design essence and generate AI coding agent prompts",
	"type": "module",
	"bin": {
		"dittofy": "./dist/cli.mjs",
		"ditto": "./dist/cli.mjs"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/seosd97/dittofy.git"
	},
	"homepage": "https://github.com/seosd97/dittofy",
	"bugs": {
		"url": "https://github.com/seosd97/dittofy/issues"
	},
	"exports": {
		".": "./dist/index.mjs"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "tsx src/app/cli/index.ts",
		"build": "tsdown",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"check": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm build",
		"prepublishOnly": "pnpm run build",
		"changeset": "changeset",
		"version:apply": "changeset version",
		"release": "pnpm build && changeset publish"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"keywords": [
		"design-system",
		"frontend",
		"analysis",
		"ai",
		"code-generation",
		"cli"
	],
	"license": "MIT",
	"dependencies": {
		"@ai-sdk/anthropic": "^3.0.0",
		"@ai-sdk/openai": "^3.0.0",
		"ai": "^6.0.0",
		"c12": "^3.3.0",
		"citty": "^0.2.1",
		"consola": "^3.4.0",
		"giget": "^3.1.0",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@changesets/cli": "^2.30.0",
		"@types/node": "^22.0.0",
		"@vitest/coverage-v8": "^3.2.4",
		"tsdown": "^0.21.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vitest": "^3.1.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"esbuild"
		]
	},
	"packageManager": "pnpm@10.25.0+sha512.5e82639027af37cf832061bcc6d639c219634488e0f2baebe785028a793de7b525ffcd3f7ff574f5e9860654e098fe852ba8ac5dd5cefe1767d23a020a92f501"
}
